# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (อย่า commit .env)

NODE_ENV=development
PORT=4000

# --- Database ---
# วิธีที่ 1 (แนะนำสำหรับ managed Postgres เช่น Railway/Render/Neon): ใช้ connection string เดียว
# DATABASE_URL=postgresql://user:password@host:5432/tinza

# วิธีที่ 2: ระบุรายตัว (ใช้ตอน dev บนเครื่องตัวเอง)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=tinza

# --- Auth ---
# production ต้องตั้งค่านี้เป็น secret แบบสุ่มยาวๆ (เช่น `openssl rand -hex 32`)
JWT_SECRET=
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# --- CORS ---
# "*" สำหรับ dev เท่านั้น; production ใส่ origin จริงคั่นด้วย comma
# CORS_ORIGINS=https://yourapp.com,https://www.yourapp.com
CORS_ORIGINS=*

# --- WebRTC ICE (GET /ice) ---
# STUN ฟรีใช้ได้เลย แต่ทะลุ NAT/CGNAT ไม่ได้ทุกเคส → production ต้องมี TURN
# คั่นหลาย url ด้วย comma
STUN_URLS=stun:stun.l.google.com:19302,stun:stun.relay.metered.ca:80
# TURN (coturn use-auth-secret): ตั้ง TURN_SECRET ให้ตรงกับ static-auth-secret ของ coturn
# ถ้าไม่ตั้ง TURN_SECRET → /ice จะคืนเฉพาะ STUN
# TURN_URLS=turn:turn.yourapp.com:3478,turns:turn.yourapp.com:5349
TURN_URLS=
TURN_SECRET=
# อายุ credential ที่ออกให้ (วินาที) — สั้นไว้ดีกว่า เพราะ credential ที่หลุด
# จะถูกใช้เป็น relay ฟรีได้จนหมดอายุ (/ice ไม่บังคับ login โดยตั้งใจ แต่มี rate limit)
TURN_TTL=600

# --- Matching ---
# ช่วงเวลาที่ทั้งคู่กด reconnect กลับมาเจอกันได้ (ms)
RECONNECT_WINDOW_MS=30000

# --- Proxy ---
# เปิดเมื่อ deploy หลัง reverse proxy (Railway/Fly/Render/nginx) เพื่ออ่าน IP จริง
# จาก X-Forwarded-For — rate limit ทั้งหมดใช้ IP เป็น key ถ้าไม่เปิด ทุกคนจะกลาย
# เป็น IP เดียวกัน (ของ proxy) แล้วโดน limit ร่วมกัน
# ห้ามเปิดถ้าเซิร์ฟเวอร์รับ request ตรงจากอินเทอร์เน็ต (client ปลอม header ได้)
TRUST_PROXY=false

# --- WebSocket limits ---
# ขนาดข้อความสูงสุด (bytes) — default ของ Bun คือ 16MB ซึ่งกว้างเกินไปมาก
WS_MAX_PAYLOAD_BYTES=16384
# ตัดการเชื่อมต่อที่เงียบเกินกี่วินาที (Bun ส่ง ping ให้เองอยู่แล้ว)
WS_IDLE_TIMEOUT_SEC=60
# จำนวน connection สูงสุดต่อ 1 IP (0 = ไม่จำกัด)
WS_MAX_CONN_PER_IP=20

# --- Database pool ---
# ทุกการจับคู่เขียน 2 แถว ทุกการกด next อัปเดต 2 แถว ปรับให้พอดีกับ
# max_connections ของ Postgres ที่ใช้อยู่
DB_POOL_MAX=20

# --- Retention ---
# ตาราง calls โต 2 แถวต่อการจับคู่ 1 ครั้ง ถ้าไม่ลบจะกลายเป็นปัญหาเอง
CALL_RETENTION_DAYS=90
# report ที่ยังไม่ได้ตรวจ (status=pending) จะไม่ถูกลบ ไม่ว่าจะเก่าแค่ไหน
REPORT_RETENTION_DAYS=365

# --- Moderation ---
# จำนวนผู้รายงานที่ไม่ซ้ำกันภายใน 30 วัน ที่ทำให้ถูกแบนอัตโนมัติ
AUTO_BAN_REPORT_THRESHOLD=5
# ระยะเวลาแบนอัตโนมัติ (ชั่วโมง)
AUTO_BAN_HOURS=72
# token สำหรับเรียก /admin/* — ถ้าไม่ตั้ง endpoint กลุ่มนี้จะตอบ 404 ทั้งหมด
# สร้างด้วย: openssl rand -hex 32
ADMIN_TOKEN=

# --- Logging ---
# debug | info | warn | error — production ควรใช้ info ขึ้นไป
# ระดับ debug จะ log ทุก connection/การจับคู่ ซึ่งเป็นคอขวดจริงเมื่อคนเยอะ
LOG_LEVEL=info
